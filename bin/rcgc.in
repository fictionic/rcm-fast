#!@SHELL@

: ${RCM_LIB:=$(dirname "$0")/../share/@PACKAGE@}
. "$RCM_LIB/rcm.sh"

show_help() {
  local exit_code=${1:-0}

  $PRINT "Usage: rcgc [-afhnqVv] [-d DOT_DIR]"
  $PRINT "see rcgc(1) and rcm(7) for more details"

  exit "$exit_code"
}

resolve_dotfiles_dirs() {
  local dotfiles_dir
  local resolved=

  # unquoted: DOTFILES_DIRS is a space-separated list
  for dotfiles_dir in $DOTFILES_DIRS; do
    dotfiles_dir="$(resolve_dotfiles_dir "$dotfiles_dir")"

    # trailing slash stripped so the prefix match in is_managed_target lines up
    resolved=$(append_variable "$resolved" "${dotfiles_dir%/}")
  done

  echo "$resolved"
}

derive_roots() {
  local dotfiles_dir
  local undotted_globs
  local never_undotted_globs
  local layer
  local entry
  local name
  local dest
  local roots=
  local seen=" "

  for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
    # the globs lsrc(1) derives for this directory, so a root is dotted the
    # way rcup(1) dotted it
    undotted_globs="$(dotfiles_dir_excludes "$dotfiles_dir" "$UNDOTTED")"
    never_undotted_globs="$(dotfiles_dir_excludes "$dotfiles_dir" "$NEVER_UNDOTTED")"

    for layer in "$dotfiles_dir" "$dotfiles_dir"/tag-* "$dotfiles_dir"/host-*; do
      [ -d "$layer" ] || continue

      for entry in "$layer"/*; do
        [ -d "$entry" ] || continue

        name="${entry##*/}"

        if is_excluded "$name" "$undotted_globs" "$never_undotted_globs"; then
          dest="$DEST_DIR/$name"
        else
          dest="$DEST_DIR/.$name"
        fi

        [ -d "$dest" ] || continue

        case "$seen" in
          *" $dest "*) ;;
          *)
            roots=$(append_variable "$roots" "$(encode "$dest")")
            seen="$seen$dest "
            ;;
        esac
      done
    done
  done

  echo "$roots"
}

is_managed_target() {
  local target="$1"
  local dotfiles_dir

  # rcm links to absolute paths, so a relative target was written by something
  # other than rcm
  case "$target" in
    /*) ;;
    *) return 1 ;;
  esac

  for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
    if [ "$target" = "$dotfiles_dir" ]; then
      return 0
    fi

    case "$target" in
      "$dotfiles_dir"/*) return 0 ;;
    esac
  done

  return 1
}

is_stale() {
  local link="$1"

  if [ ! -L "$link" ] || [ -e "$link" ]; then
    return 1
  fi

  is_managed_target "$(readlink "$link")"
}

scan() {
  local dotfiles_dir
  local root

  if [ "$SCAN_ALL" -eq 1 ]; then
    # in -a mode, we scan the whole DEST_DIR, filtering out all DOTFILES_DIRS
    # (anything within an rcm-managed repo is its own business).
    set --

    for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
      set -- "$@" -path "$dotfiles_dir" -prune -o
    done

    find "$DEST_DIR" -xdev "$@" -type l -print 2>/dev/null
  else
    # normal mode: scan for common dotfiles at the top level of DEST_DIR, then
    # scan within the destinations contained within each tag- and host- ROOT.
    find "$DEST_DIR" -xdev -maxdepth 1 -type l -print 2>/dev/null

    if [ -n "$ROOTS" ]; then
      set --

      for root in $ROOTS; do
        set -- "$@" "$(decode "$root")"
      done

      find "$@" -xdev -type l -print 2>/dev/null
    fi
  fi

  return 0
}

announce_scope() {
  local root

  if [ "$SCAN_ALL" -eq 1 ]; then
    $VERBOSE "scanning all of $DEST_DIR"
    return 0
  fi

  $VERBOSE "scanning $DEST_DIR at the top level"

  for root in $ROOTS; do
    $VERBOSE "scanning $(decode "$root")"
  done
}

handle_command_line() {
  local opt
  local verbosity=0
  local version=0
  local dotfiles_dirs=

  while getopts :afhnqvVd: opt; do
    case "$opt" in
      a) SCAN_ALL=1 ;;
      d) dotfiles_dirs="$(append_variable "$dotfiles_dirs" "$OPTARG")" ;;
      f) MODE=force ;;
      h) show_help ;;
      n) MODE=list ;;
      q) verbosity=$((verbosity - 1)) ;;
      v) verbosity=$((verbosity + 1)) ;;
      V) version=1 ;;
      ?) show_help 64 ;;
    esac
  done
  shift $((OPTIND - 1))

  handle_common_flags rcgc $version $verbosity

  VERBOSITY=$verbosity
  DOTFILES_DIRS="${dotfiles_dirs:-$DOTFILES_DIRS}"

  if [ $# -ne 0 ]; then
    show_help 64
  fi
}

MODE=prompt
SCAN_ALL=0
VERBOSITY=0

handle_command_line "$@"

: ${DOTFILES_DIRS:=$DEFAULT_DOTFILES_DIR}
$DEBUG "DOTFILES_DIRS: $DOTFILES_DIRS"

: ${UNDOTTED:=""}
$DEBUG "UNDOTTED: $UNDOTTED"

: ${NEVER_UNDOTTED:=""}
$DEBUG "NEVER_UNDOTTED: $NEVER_UNDOTTED"

DOTFILES_DIRS_RESOLVED=$(resolve_dotfiles_dirs)
ROOTS=$(derive_roots)

announce_scope

TMPFILE=$(mktemp "${TMPDIR:-/tmp}/rcgc.XXXXXX")
trap 'rm -f "$TMPFILE"' EXIT

scan | LC_ALL=C sort > "$TMPFILE"

found=0

while IFS= read -r link; do
  is_stale "$link" || continue

  found=$((found + 1))

  case "$MODE" in
    force) ;;
    *) $PRINT "stale: $link -> $(readlink "$link")" ;;
  esac
done < "$TMPFILE"

if [ "$found" -eq 0 ]; then
  $PRINT "clean"
  exit 0
fi

case "$MODE" in
  list)
    $PRINT "$found stale link(s)"
    exit 0
    ;;
  prompt)
    # can't prompt in quiet mode; just exit
    if [ "$VERBOSITY" -lt 0 ]; then
      exit 0
    fi

    $PROMPT "remove $found stale link(s)? [yN]"
    read -r answer

    case "$answer" in
      y) ;;
      *) exit 0 ;;
    esac
    ;;
esac

# no pre/post-hooks to run for gc. don't think that's really a coherent feature.

# re-test links for staleness before deleting, for safety.
# note that this might mean we delete things we didn't list.
while IFS= read -r link; do
  is_stale "$link" || continue

  $PRINT "removing: $link -> $(readlink "$link")"
  rm -- "$link"

  # drop the containing directory if the link was the last thing in it, but
  # never $DEST_DIR itself
  parent="${link%/*}"
  case "$parent" in
    "" | "/" | "$DEST_DIR") ;;
    *) rmdir -- "$parent" 2>/dev/null || true ;;
  esac
done < "$TMPFILE"

# the rmdir fails on non-empty directories; don't take its exit status with us
exit 0
