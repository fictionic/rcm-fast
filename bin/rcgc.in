#!@SHELL@

: ${RCM_LIB:=$(dirname "$0")/../share/@PACKAGE@}
. "$RCM_LIB/rcm.sh"

show_help() {
  local exit_code=${1:-0}

  $PRINT "Usage: rcgc [-afhnqVv] [-d DOT_DIR]"
  $PRINT "see rcgc(1) and rcm(7) for more details"

  exit "$exit_code"
}

resolve_dotfiles_dirs() {
  local dotfiles_dir
  local resolved=

  # unquoted: DOTFILES_DIRS is a space-separated list
  for dotfiles_dir in $DOTFILES_DIRS; do
    dotfiles_dir="$(resolve_dotfiles_dir "$dotfiles_dir")"

    # trailing slash stripped so the prefix match in is_managed_target lines up
    resolved=$(append_variable "$resolved" "${dotfiles_dir%/}")
  done

  echo "$resolved"
}

is_physical_dir() {
  [ -d "$1" ] && [ ! -L "$1" ]
}

# expand GC_SHALLOW_DIRS such that all ancestors of each path are also included:
# if foo/bar/ is declared shallow, then this implies that foo/ must be shallow.
expand_shallow_dirs() {
  local glob
  local prefix
  local expanded=
  local had_noglob

  case "$-" in
    *f*) had_noglob=1 ;;
    *) had_noglob= ;;
  esac

  set -o noglob

  for glob in $GC_SHALLOW_DIRS; do
    prefix="$glob"

    while [ "$prefix" != "${prefix%/*}" ]; do
      expanded=$(append_variable "$expanded" "$prefix")
      prefix="${prefix%/*}"
    done

    expanded=$(append_variable "$expanded" "$prefix")
  done

  [ -n "$had_noglob" ] || set +o noglob

  echo "$expanded"
}

# record a new scan haystack, and whether it should be scanned deeply or
# shallowly.
add_haystack() {
  local dest="$1"
  local shallow="$2"

  # a given haystack may be included by multiple roots. dedupe.
  local encoded="$(encode "$dest")"
  case "$SEEN_HAYSTACKS" in
    *" $encoded "*) return 0 ;;
  esac

  SEEN_HAYSTACKS="$SEEN_HAYSTACKS$encoded "

  if [ "$shallow" -eq 1 ]; then
    SHALLOW_HAYSTACKS=$(append_variable "$SHALLOW_HAYSTACKS" "$encoded")
  else
    HAYSTACKS=$(append_variable "$HAYSTACKS" "$encoded")
  fi
}

# each dotfile-containing subdir of a shallow haystack becomes a haystack of
# its own.
add_shallow_children() {
  local entry="$1"
  local haystack_path="$2"
  local haystack_rel="$3"
  local child
  local child_name
  local child_path
  local child_rel

  for child in "$entry"/*; do
    [ -d "$child" ] || continue

    child_name="${child##*/}"
    child_path="$haystack_path/$child_name"
    child_rel="$haystack_rel/$child_name"

    # again, skip SYMLINK_DIRS symlinks
    is_physical_dir "$child_path" || continue

    if is_excluded "$child_rel" "$GC_SHALLOW_DIRS_EXPANDED" ""; then
      add_haystack "$child_path" 1
      add_shallow_children "$child" "$child_path" "$child_rel"
    else
      add_haystack "$child_path" 0
    fi
  done
}

# determine the scope of the scan: which haystacks will be scanned, and which
# should be deep vs shallow.
derive_haystacks() {
  local dotfiles_dir
  local undotted_globs
  local never_undotted_globs
  local layer
  local entry
  local haystack_name
  local haystack_path

  HAYSTACKS=
  SHALLOW_HAYSTACKS=
  SEEN_HAYSTACKS=" "

  for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
    undotted_globs="$(dotfiles_dir_excludes "$dotfiles_dir" "$UNDOTTED")"
    never_undotted_globs="$(dotfiles_dir_excludes "$dotfiles_dir" "$NEVER_UNDOTTED")"

    for layer in "$dotfiles_dir" "$dotfiles_dir"/tag-* "$dotfiles_dir"/host-*; do
      [ -d "$layer" ] || continue

      for entry in "$layer"/*; do
        [ -d "$entry" ] || continue

        haystack_name="${entry##*/}"

        # skip root-level hooks, tag- and host- directories
        if [ "$layer" = "$dotfiles_dir" ] && is_metafile "$haystack_name"; then
          continue
        fi

        if is_excluded "$haystack_name" "$undotted_globs" "$never_undotted_globs"; then
          haystack_path="$DEST_DIR/$haystack_name"
        else
          haystack_path="$DEST_DIR/.$haystack_name"
        fi

        # skip SYMLINK_DIRS symlinks
        is_physical_dir "$haystack_path" || continue

        if ! is_excluded "$haystack_name" "$GC_SHALLOW_DIRS_EXPANDED" ""; then
          # normal (deep) haystack
          add_haystack "$haystack_path" 0
          continue
        fi

        # shallow haystack
        add_haystack "$haystack_path" 1

        add_shallow_children "$entry" "$haystack_path" "$haystack_name"
      done
    done
  done
}

is_managed_target() {
  local target="$1"
  local dotfiles_dir

  # rcm links to absolute paths, so a relative target was written by something
  # other than rcm
  case "$target" in
    /*) ;;
    *) return 1 ;;
  esac

  for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
    if [ "$target" = "$dotfiles_dir" ]; then
      return 0
    fi

    case "$target" in
      "$dotfiles_dir"/*) return 0 ;;
    esac
  done

  return 1
}

is_stale() {
  local link="$1"

  if [ ! -L "$link" ] || [ -e "$link" ]; then
    return 1
  fi

  is_managed_target "$(readlink "$link")"
}

scan() {
  local dotfiles_dir
  local haystack

  if [ "$SCAN_ALL" -eq 1 ]; then
    # scan-all mode: scan all of DEST_DIR, but exclude all DOTFILES_DIRS.
    # (dotfiles dirs should not link into each other, so there _shouldn't_ be
    # any broken symlinks pointing into other dotfiles dirs, but if there were,
    # we still wouldn't want to delete them, because they're part of the user's
    # rcm configuration.)
    set --
    for dotfiles_dir in $DOTFILES_DIRS_RESOLVED; do
      set -- "$@" -path "$dotfiles_dir" -prune -o
    done
    find "$DEST_DIR" -xdev "$@" -type l -print 2>/dev/null
  else
    # normal mode: first, scan just the top level of DEST_DIR
    find "$DEST_DIR" -xdev -maxdepth 1 -type l -print 2>/dev/null

    # then, scan only the top level of each shallow haystack
    if [ -n "$SHALLOW_HAYSTACKS" ]; then
      set --
      for haystack in $SHALLOW_HAYSTACKS; do
        set -- "$@" "$(decode "$haystack")"
      done
      find "$@" -xdev -maxdepth 1 -type l -print 2>/dev/null
    fi

    # then, scan all of each normal haystack
    if [ -n "$HAYSTACKS" ]; then
      set --
      for haystack in $HAYSTACKS; do
        set -- "$@" "$(decode "$haystack")"
      done
      find "$@" -xdev -type l -print 2>/dev/null
    fi
  fi

  return 0
}

announce_scope() {
  local haystack

  if [ "$SCAN_ALL" -eq 1 ]; then
    $VERBOSE "scanning $DEST_DIR (deep)..."
    return 0
  fi

  $VERBOSE "scanning $DEST_DIR (shallow)..."

  for haystack in $SHALLOW_HAYSTACKS; do
    $VERBOSE "scanning $(decode "$haystack") (shallow)..."
  done

  for haystack in $HAYSTACKS; do
    $VERBOSE "scanning $(decode "$haystack") (deep)..."
  done
}

handle_command_line() {
  local opt
  local verbosity=0
  local version=0
  local dotfiles_dirs=

  while getopts :afhnqvVd: opt; do
    case "$opt" in
      a) SCAN_ALL=1 ;;
      d) dotfiles_dirs="$(append_variable "$dotfiles_dirs" "$OPTARG")" ;;
      f) MODE=force ;;
      h) show_help ;;
      n) MODE=list ;;
      q) verbosity=$((verbosity - 1)) ;;
      v) verbosity=$((verbosity + 1)) ;;
      V) version=1 ;;
      ?) show_help 64 ;;
    esac
  done
  shift $((OPTIND - 1))

  handle_common_flags rcgc $version $verbosity

  VERBOSITY=$verbosity
  DOTFILES_DIRS="${dotfiles_dirs:-$DOTFILES_DIRS}"

  if [ $# -ne 0 ]; then
    show_help 64
  fi
}

MODE=prompt
SCAN_ALL=0
VERBOSITY=0

handle_command_line "$@"

: ${DOTFILES_DIRS:=$DEFAULT_DOTFILES_DIR}
$DEBUG "DOTFILES_DIRS: $DOTFILES_DIRS"

: ${UNDOTTED:=""}
$DEBUG "UNDOTTED: $UNDOTTED"

: ${NEVER_UNDOTTED:=""}
$DEBUG "NEVER_UNDOTTED: $NEVER_UNDOTTED"

: ${GC_SHALLOW_DIRS:=""}
$DEBUG "GC_SHALLOW_DIRS: $GC_SHALLOW_DIRS"

GC_SHALLOW_DIRS_EXPANDED=$(expand_shallow_dirs)
$DEBUG "GC_SHALLOW_DIRS_EXPANDED: $GC_SHALLOW_DIRS_EXPANDED"

DOTFILES_DIRS_RESOLVED=$(resolve_dotfiles_dirs)
$DEBUG "DOTFILES_DIRS_RESOLVED: $DOTFILES_DIRS_RESOLVED"

derive_haystacks

announce_scope

TMPFILE=$(mktemp "${TMPDIR:-/tmp}/rcgc.XXXXXX")
trap 'rm -f "$TMPFILE"' EXIT

scan | LC_ALL=C sort > "$TMPFILE"

found=0

while IFS= read -r link; do
  is_stale "$link" || continue

  found=$((found + 1))

  case "$MODE" in
    force) ;;
    *) $PRINT "stale: $link -> $(readlink "$link")" ;;
  esac
done < "$TMPFILE"

if [ "$found" -eq 0 ]; then
  $PRINT "clean"
  exit 0
fi

case "$MODE" in
  list)
    $PRINT "$found stale link(s)"
    exit 0
    ;;
  prompt)
    # can't prompt in quiet mode; just exit
    if [ "$VERBOSITY" -lt 0 ]; then
      exit 0
    fi

    $PROMPT "remove $found stale link(s)? [yN]"
    read -r answer

    case "$answer" in
      [Yy]*) ;;
      *) exit 0 ;;
    esac
    ;;
esac

# no pre/post-hooks to run for gc. don't think that's really a coherent feature.

# re-test links for staleness before deleting, for safety.
# note that this might mean we delete things we didn't list.
while IFS= read -r link; do
  is_stale "$link" || continue

  $PRINT "removing: $link -> $(readlink "$link")"
  rm -- "$link"

  prune_empty_dirs "${link%/*}"
done < "$TMPFILE"
