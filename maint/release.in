#!/bin/sh

PACKAGE='@PACKAGE@'
PACKAGE_VERSION='@PACKAGE_VERSION@'
srcdir='@srcdir@'

# Arch
release_build_arch() {
  generate_dist_sha && \
    edit_package arch/PKGBUILD.in > arch/PKGBUILD
}

release_push_arch() {
  echo >&2 "release: publishing to the AUR is not automated; upload arch/PKGBUILD"
  echo >&2 "         and its .SRCINFO to the AUR repository by hand."
  exit 1
}

release_clean_arch() {
  rm -f arch/PKGBUILD
}

generate_dist_sha() {
  export DIST_SHA=$(openssl sha256 $srcdir/$DIST_ARCHIVES | cut -d' ' -f2)
}

edit_package() {
  sed \
    -e "s|@PACKAGE[@]|$PACKAGE|g" \
    -e "s|@PACKAGE_VERSION[@]|$PACKAGE_VERSION|g" \
    -e "s|@DIST_ARCHIVES[@]|$DIST_ARCHIVES|g" \
    -e "s|@DIST_SHA[@]|$DIST_SHA|g" \
    "$1"
}

# Tag
release_build_tag() {
  git tag -s v$PACKAGE_VERSION -m "Release $PACKAGE_VERSION"
}

release_push_tag() {
  git push origin --tags
}

release_clean_tag() {
  :
}

# GitHub release
release_build_github() {
  gh release create "v$PACKAGE_VERSION" "$srcdir/$DIST_ARCHIVES" \
    --draft \
    --title "$PACKAGE $PACKAGE_VERSION" \
    --notes "$(extract_news)"
}

release_push_github() {
  gh release edit "v$PACKAGE_VERSION" --draft=false
}

release_clean_github() {
  rm -f "$srcdir/$DIST_ARCHIVES"
}

# The topmost stanza of NEWS.md, without its header or signature line.
extract_news() {
  sed -n '3,/^ -- /{/^ -- /d;p;}' "$srcdir/NEWS.md"
}

# Main:

if [ $# -lt 3 ]; then
  echo "Usage: release (build|push|clean) (tag|github|arch) DIST_ARCHIVES" >&2
  exit 64
fi

if ! command -v git >/dev/null; then
  echo >&2 "release: missing dependency: git"
  exit 1
fi

if ! command -v gh >/dev/null; then
  echo >&2 "release: missing dependency: gh"
  exit 1
fi

verb="$1"
noun="$2"
DIST_ARCHIVES="$3"
cmd="release_${verb}_${noun}"

${cmd}
