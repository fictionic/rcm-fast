# Maintainer: Dylan Forbes <dylandforbes@gmail.com>
_gitname='@PACKAGE@'
pkgname=$_gitname-git
pkgver=@PACKAGE_VERSION@
pkgrel=1
pkgdesc="rcm, but faster"
arch=('any')
url="https://github.com/fictionic/rcm-fast"
license=('BSD')
provides=('rcm' "$_gitname")
conflicts=('rcm' "$_gitname")
makedepends=('git' 'python-pystache')
checkdepends=('cram')
source=("$_gitname::git+https://github.com/fictionic/rcm-fast.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_gitname"
  git describe --long --tags | sed -r 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

prepare() {
  cd "$srcdir/$_gitname"
  ./autogen.sh
}

build() {
  cd "$srcdir/$_gitname"
  ./configure \
    --disable-silent-rules \
    --prefix=/usr
  make
}

check() {
  cd "$srcdir/$_gitname"
  LC_ALL=C make check
}

package() {
  cd "$srcdir/$_gitname"
  make DESTDIR="$pkgdir/" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim:set ts=2 sw=2 et:
